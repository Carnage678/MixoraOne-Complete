// MixoraOne primary relational schema.
// Domain models land epic by epic (auth, products, commerce, ...).
// The datasource URL lives in apps/api/prisma.config.ts (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------------------------
// Epic 2 - Authentication and RBAC (ADR 0002)
// Static enum roles for now; dynamic role tables are deferred until needed.
// --------------------------------------------------------------------------

enum UserRole {
  USER
  DEVELOPER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  /// Null for OAuth-only accounts.
  passwordHash    String?
  name            String
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts                Account[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]
  organizationMemberships OrganizationMember[]
  developerProfile        DeveloperProfile?
  favorites               Favorite[]
  orders                  Order[]
  subscriptions           Subscription[]
  invoices                Invoice[]
  licenses                License[]
  licenseSeats            LicenseSeat[]
  reviews                 Review[]
  questions               Question[]
  answers                 Answer[]
  feedback                Feedback[]
  reports                 Report[]
  disputes                Dispute[]

  @@map("users")
}

/// External OAuth identities linked to a user.
model Account {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Opaque refresh tokens, stored hashed. Rotation chains share a familyId so
/// reuse of a rotated token can revoke the whole session family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Immutable security and business audit trail.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// --------------------------------------------------------------------------
// Epic 3 - User and Organization Management
// Organizations group buyers or developer teams; membership carries an
// org-scoped role independent of the platform role.
// --------------------------------------------------------------------------

enum OrganizationRole {
  OWNER
  MEMBER
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// --------------------------------------------------------------------------
// Epic 4 - Developer Profiles
// Public developer identity plus verification submissions. Admin decisions
// on verifications arrive with the trust/moderation epic.
// --------------------------------------------------------------------------

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model DeveloperProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  slug        String    @unique
  displayName String
  headline    String?
  bio         String?
  websiteUrl  String?
  githubUrl   String?
  skills      String[]  @default([])
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications DeveloperVerification[]
  products      Product[]
  reviewReplies ReviewReply[]

  @@map("developer_profiles")
}

model DeveloperVerification {
  id           String             @id @default(uuid()) @db.Uuid
  profileId    String             @db.Uuid
  status       VerificationStatus @default(PENDING)
  legalName    String
  country      String
  websiteUrl   String?
  evidenceUrl  String?
  note         String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime           @default(now())

  profile DeveloperProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([status, createdAt])
  @@map("developer_verifications")
}

// --------------------------------------------------------------------------
// Epic 5 - Product Listings and Versioning
// Products belong to developer profiles. Assets are URL-based until the
// storage epic introduces signed uploads.
// --------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingType {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

enum BillingInterval {
  MONTH
  YEAR
}

enum AssetKind {
  SCREENSHOT
  VIDEO
  DOCUMENT
  LINK
}

model Product {
  id                 String        @id @default(uuid()) @db.Uuid
  developerProfileId String        @db.Uuid
  slug               String        @unique
  name               String
  tagline            String?
  description        String?
  category           String?
  status             ProductStatus @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  developerProfile  DeveloperProfile       @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)
  versions          ProductVersion[]
  assets            ProductAsset[]
  docs              ProductDoc[]
  pricingPlans      ProductPricingPlan[]
  statusHistory     ProductStatusHistory[]
  productCategories      ProductCategory[]
  favorites              Favorite[]
  aiConversations        AiConversation[]
  contentSuggestions     ProductContentSuggestion[]
  orderItems             OrderItem[]
  subscriptions          Subscription[]
  licenses               License[]
  reviews                Review[]
  questions              Question[]
  productDailyMetrics    ProductDailyMetric[]
  analyticsEvents        AnalyticsEvent[]
  feedback               Feedback[]

  @@index([developerProfileId])
  @@index([status, publishedAt])
  @@map("products")
}

model ProductVersion {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  semver    String
  changelog String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, semver])
  @@index([productId, createdAt])
  @@map("product_versions")
}

model ProductAsset {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  kind      AssetKind
  title     String
  url       String
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_assets")
}

model ProductDoc {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  slug      String
  title     String
  content   String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, slug])
  @@index([productId, position])
  @@map("product_docs")
}

model ProductPricingPlan {
  id         String           @id @default(uuid()) @db.Uuid
  productId  String           @db.Uuid
  name       String
  type       PricingType
  priceCents Int              @default(0)
  currency   String           @default("USD")
  interval   BillingInterval?
  seats      Int?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  subscriptions Subscription[]
  licenses License[]

  @@index([productId, isActive])
  @@map("product_pricing_plans")
}

model ProductStatusHistory {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @db.Uuid
  fromStatus  ProductStatus
  toStatus    ProductStatus
  actorUserId String?       @db.Uuid
  note        String?
  createdAt   DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("product_status_history")
}

// --------------------------------------------------------------------------
// Epic 6 - Marketplace Discovery and Search
// Curated category taxonomy, saved products, and search analytics events.
// --------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  productCategories ProductCategory[]

  @@map("categories")
}

model ProductCategory {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @db.Uuid
  categoryId String @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("favorites")
}

/** Append-only search analytics; feeds ranking and the analytics epic. */
model SearchEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  query       String
  category    String?
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("search_events")
}

// --------------------------------------------------------------------------
// Epic 7 - AI Requirement Assistant
// Conversations, messages with provider/token metadata, and catalog-grounded
// product recommendations. Providers are swappable behind LlmProviderPort.
// --------------------------------------------------------------------------

enum AiConversationKind {
  REQUIREMENT
  DEVELOPER_ASSISTANT
}

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiConversation {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  kind      AiConversationKind
  productId String?            @db.Uuid
  title     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  product         Product?                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages        AiMessage[]
  recommendations AiRecommendation[]
  suggestions     ProductContentSuggestion[]

  @@index([userId, kind, createdAt])
  @@index([productId, createdAt])
  @@map("ai_conversations")
}

// Epic 8 - AI Developer Assistant structured listing improvements.
enum ContentSuggestionField {
  TAGLINE
  DESCRIPTION
  CATEGORY
  CHANGELOG
  DOC
}

enum ContentSuggestionStatus {
  PENDING
  APPLIED
  DISMISSED
}

model ProductContentSuggestion {
  id             String                  @id @default(uuid()) @db.Uuid
  productId      String                  @db.Uuid
  conversationId String?                 @db.Uuid
  field          ContentSuggestionField
  currentValue   String?
  suggestedValue String
  reason         String
  status         ContentSuggestionStatus @default(PENDING)
  createdAt      DateTime                @default(now())

  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([conversationId, createdAt])
  @@map("product_content_suggestions")
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  role           AiMessageRole
  content        String
  provider       String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiRecommendation {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  productId      String   @db.Uuid
  reason         String
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_recommendations")
}

// --------------------------------------------------------------------------
// Epic 9 - Payments and Orders
// Checkout, payment webhooks, subscriptions, and invoices. Payment providers
// are swappable behind PaymentProviderPort (mock for dev/tests, Stripe in prod).
// --------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @db.Uuid
  status            OrderStatus @default(PENDING)
  totalCents        Int
  currency          String      @default("USD")
  idempotencyKey    String?
  provider          String?
  providerSessionId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  payments     Payment[]
  invoice      Invoice?
  subscription Subscription?
  license      License?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @db.Uuid
  productId      String      @db.Uuid
  pricingPlanId  String      @db.Uuid
  productName    String
  planName       String
  pricingType    PricingType
  quantity       Int         @default(1)
  unitPriceCents Int
  currency       String      @default("USD")
  createdAt      DateTime    @default(now())

  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  pricingPlan ProductPricingPlan @relation(fields: [pricingPlanId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  provider          String
  providerPaymentId String
  status            PaymentStatus @default(PENDING)
  amountCents       Int
  currency          String        @default("USD")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String             @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  processedAt DateTime?
  error       String?
  createdAt   DateTime           @default(now())

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@map("payment_webhook_events")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  productId              String             @db.Uuid
  pricingPlanId          String             @db.Uuid
  orderId                String?            @unique @db.Uuid
  provider               String
  providerSubscriptionId String?
  status                 SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd       DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  pricingPlan ProductPricingPlan @relation(fields: [pricingPlanId], references: [id], onDelete: Restrict)
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoices    Invoice[]
  license     License?

  @@index([userId, status, createdAt])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  orderId        String?       @unique @db.Uuid
  subscriptionId String?       @db.Uuid
  number         String        @unique
  amountCents    Int
  currency       String        @default("USD")
  status         InvoiceStatus @default(DRAFT)
  issuedAt       DateTime      @default(now())
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("invoices")
}

// --------------------------------------------------------------------------
// Epic 10 - Licensing and Entitlements
// Grants created from paid orders; seats and device activations enforce access.
// --------------------------------------------------------------------------

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

model License {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  productId      String        @db.Uuid
  pricingPlanId  String        @db.Uuid
  orderId        String        @unique @db.Uuid
  subscriptionId String?       @unique @db.Uuid
  licenseKeyHash String
  keyHint        String
  status         LicenseStatus @default(ACTIVE)
  seatLimit      Int           @default(1)
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  pricingPlan  ProductPricingPlan  @relation(fields: [pricingPlanId], references: [id], onDelete: Restrict)
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subscription Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  seats        LicenseSeat[]
  activations  LicenseActivation[]

  @@index([userId, status, createdAt])
  @@index([productId])
  @@map("licenses")
}

model LicenseSeat {
  id             String    @id @default(uuid()) @db.Uuid
  licenseId      String    @db.Uuid
  assignedUserId String?   @db.Uuid
  assignedEmail  String?
  assignedAt     DateTime?
  createdAt      DateTime  @default(now())

  license      License             @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  assignedUser User?               @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  activations  LicenseActivation[]

  @@index([licenseId, createdAt])
  @@index([assignedUserId])
  @@map("license_seats")
}

model LicenseActivation {
  id                 String    @id @default(uuid()) @db.Uuid
  licenseId          String    @db.Uuid
  seatId             String?   @db.Uuid
  userId             String    @db.Uuid
  deviceId           String
  deviceName         String?
  activationTokenHash String   @unique
  lastSeenAt         DateTime  @default(now())
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  license License      @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  seat    LicenseSeat? @relation(fields: [seatId], references: [id], onDelete: SetNull)

  @@unique([licenseId, deviceId, userId])
  @@index([licenseId, revokedAt])
  @@map("license_activations")
}

// --------------------------------------------------------------------------
// Epic 11 - Reviews, Q&A, and Feedback
// --------------------------------------------------------------------------

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

model Review {
  id               String       @id @default(uuid()) @db.Uuid
  productId        String       @db.Uuid
  userId           String       @db.Uuid
  orderId          String?      @db.Uuid
  rating           Int
  title            String?
  body             String
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PUBLISHED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies ReviewReply[]

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@map("reviews")
}

model ReviewReply {
  id                 String   @id @default(uuid()) @db.Uuid
  reviewId           String   @db.Uuid
  developerProfileId String   @db.Uuid
  body               String
  createdAt          DateTime @default(now())

  review  Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  profile DeveloperProfile @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@map("review_replies")
}

model Question {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String
  createdAt DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([productId, createdAt])
  @@map("questions")
}

model Answer {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  userId     String   @db.Uuid
  body       String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt])
  @@map("answers")
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String?  @db.Uuid
  subject   String
  body      String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("feedback")
}

enum ReportTargetType {
  REVIEW
  QUESTION
  PRODUCT
  USER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model Report {
  id             String           @id @default(uuid()) @db.Uuid
  reporterUserId String           @db.Uuid
  targetType     ReportTargetType
  targetId       String           @db.Uuid
  reason         String
  details        String?
  status         ReportStatus     @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  reporter        User             @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  moderationCases ModerationCase[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

// --------------------------------------------------------------------------
// Epic 12 - Trust Verification and Moderation
// --------------------------------------------------------------------------

enum TrustCheckKind {
  DEVELOPER
  PRODUCT
  DOMAIN
  COMPLIANCE
}

enum TrustCheckStatus {
  PENDING
  APPROVED
  REJECTED
}

model TrustCheck {
  id              String           @id @default(uuid()) @db.Uuid
  kind            TrustCheckKind
  subjectType     String
  subjectId       String           @db.Uuid
  status          TrustCheckStatus @default(PENDING)
  evidence        String?
  decidedByUserId String?          @db.Uuid
  decisionNote    String?
  createdAt       DateTime         @default(now())
  decidedAt       DateTime?

  @@index([status, createdAt])
  @@index([subjectType, subjectId])
  @@map("trust_checks")
}

enum ModerationCaseStatus {
  OPEN
  RESOLVED
}

enum ModerationDecision {
  APPROVE
  REMOVE
  WARN
}

model ModerationCase {
  id              String               @id @default(uuid()) @db.Uuid
  reportId        String?              @db.Uuid
  subjectType     String
  subjectId       String               @db.Uuid
  status          ModerationCaseStatus @default(OPEN)
  decision        ModerationDecision?
  decidedByUserId String?              @db.Uuid
  decisionNote    String?
  createdAt       DateTime             @default(now())
  resolvedAt      DateTime?

  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("moderation_cases")
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String?       @db.Uuid
  reporterUserId  String        @db.Uuid
  respondentUserId String?      @db.Uuid
  reason          String
  status          DisputeStatus @default(OPEN)
  resolution      String?
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  reporter User @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("disputes")
}

// --------------------------------------------------------------------------
// Epic 13 - Analytics
// --------------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  userId    String?  @db.Uuid
  productId String?  @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([productId, createdAt])
  @@map("analytics_events")
}

model ProductDailyMetric {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  date         DateTime @db.Date
  views        Int      @default(0)
  favorites    Int      @default(0)
  orders       Int      @default(0)
  revenueCents Int      @default(0)
  reviews      Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@map("product_daily_metrics")
}
