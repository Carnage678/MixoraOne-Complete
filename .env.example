# ---------------------------------------------------------------------------
# MixoraOne environment template.
# Copy to `.env` and adjust values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# API (apps/api)
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://mixora:mixora@localhost:5432/mixoraone?schema=public

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Public URLs
WEB_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Auth (Epic 2)
# HS256 secret; provide JWT_PRIVATE_KEY/JWT_PUBLIC_KEY (PEM) to switch to RS256.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OAuth (optional in development; endpoints return 503 until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI assistant (Epic 7). Pick one provider and set its key; endpoints return
# 503 until configured. Models are overridable (OPENAI_MODEL, GEMINI_MODEL,
# ANTHROPIC_MODEL).
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Payments (Epic 9). Mock provider works locally without external services.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
